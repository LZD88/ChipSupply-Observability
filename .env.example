CHIP_AGENT_PASSWORD=
CHIP_JWT_SECRET=
DEEPSEEK_API_KEY=
GRAFANA_ADMIN_PASSWORD=
RABBITMQ_DEFAULT_PASSWORD=
# 使用不含引号的随机 URL-safe 值；三个值必须不同，签名密钥至少 32 字节。
